# Python 缓存文件
__pycache__/
*.pyc
*.pyo
*.pyd

# 虚拟环境
.venv/
venv/

# IDE 配置文件
.idea/
.vscode/

# 日志文件
*.log
logs/

# 临时文件
*.tmp
*.bak

# 环境变量文件（防止密钥泄露）
.env
.env.*
# 但保留示例模板（仅含占位符，可安全提交）
!.env.example

# 忽略临时测试文件
test.py

# 忽略所有 npm 依赖包
node_modules/

# 忽略所有 Markdown 文件
*.md

# 忽略所有静态文件
news-info-backend/static/